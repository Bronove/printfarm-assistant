{
  "name": "printfarm-assistant",
  "private": true,
  "version": "1.5.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:backend": "node tools/run-python.mjs tests/backend-smoke.py",
    "test:e2e:packaged": "node tests/packaged-e2e.mjs",
    "test:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/installer-e2e.ps1",
    "test:installer:inno": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/inno-installer-e2e.ps1",
    "test:all": "npm run test:backend && npm run test:ui && npm run test:e2e:packaged && npm run test:installer:inno"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "playwright-core": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
